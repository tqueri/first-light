{
  "name": "first-light",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx scripts/with-db.mts next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "build:local": "tsx scripts/with-db.mts next build",
    "start:local": "tsx scripts/with-db.mts next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db": "tsx scripts/with-db.mts",
    "db:studio": "tsx scripts/with-db.mts prisma studio",
    "db:migrate": "tsx scripts/with-db.mts prisma migrate dev",
    "ingest:mast": "tsx scripts/with-db.mts tsx scripts/ingest-mast.mts",
    "ingest:gallery": "tsx scripts/with-db.mts tsx scripts/ingest-gallery.mts",
    "ingest:exo": "tsx scripts/with-db.mts tsx scripts/ingest-exo.mts",
    "ingest": "pnpm ingest:gallery && pnpm ingest:exo && pnpm ingest:mast",
    "lab:build": "tsx scripts/with-db.mts tsx scripts/build-lab.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@vercel/config": "^0.15.0",
    "embedded-postgres": "18.7.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "node-html-parser": "^9.0.7",
    "prisma": "7.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.3.0"
}
