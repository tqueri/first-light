# Copy to .env (or .env.local) and adjust.
# Local default = the embedded Postgres booted by `pnpm dev`; any other URL is used as-is.
POSTGRES_URL="postgresql://postgres:postgres@127.0.0.1:54329/firstlight"
# Protects /api/cron/refresh (Vercel sends it as a Bearer token). Any long random string.
CRON_SECRET=""
